#!/usr/bin/env python3
# SPDX-License-Identifier: BSD-3-Clause
"""Human summary of benchmark JSONL files: the environment with every
warning, calibration, then one line per implementation."""

import argparse
import os
import signal
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import bm_stats  # noqa: E402


def onoff(v, on="on", off="off"):
    return "unknown" if v is None else (on if v else off)


def env_lines(run):
    e = run.env
    busy = e.get("sibling_busy")
    sib = ("sibling cpu %s busy %.0f%%" % (e.get("sibling"), 100 * busy)
           if busy is not None else "no SMT sibling online")
    yield "git %s, %s, core %s (%s), DPDK %s, profile %s" % (
        e.get("git"), e.get("cpu"), e.get("core"), e.get("core_type"),
        e.get("dpdk"), e.get("profile"))
    yield "PMU %s, unit %s, page size %s, build %s, governor %s, turbo %s, %s, %s" % (
        e.get("pmu_mode"), run.unit, e.get("page_size"), e.get("build_type"),
        e.get("governor"), onoff(e.get("turbo")), sib,
        "isolated" if e.get("isolated") or e.get("nohz_full") else "not isolated")


def calib_line(run):
    c = run.calibration.get("chained", {})
    t = run.calibration.get("throughput", {})
    st = run.selftest
    return ("calibration: chained a %.2f, floor %.2f; throughput floor %.2f; "
            "self-test slope %s, ratio %s, timer %s, confirmed %s" % (
                c.get("a", float("nan")), c.get("floor", float("nan")),
                t.get("floor", float("nan")), st.get("slope"), st.get("ratio"),
                st.get("timer"), st.get("confirmed")))


def call_width(unit):
    # the per-call column fits its label ("cycles/call", "tsc/call")
    return max(10, len(unit) + len("/call"))


def bench_line(b, unit):
    s = bm_stats.summarize(b, unit)
    lo, hi = s["ci"]
    notes = []
    if s["harness_bound_uncertain"]:
        notes.append("harness-bound uncertain")
    elif s["harness_bound"]:
        notes.append("HARNESS-BOUND")
    if s["layout_sensitive"]:
        notes.append("layout-sensitive")
    rej = s["rejected"]
    per_op = ("%10.2f" % s["corrected_per_op"]) if s["corrected_per_op"] is not None else "%10s" % "-"
    return "%-36s %*.2f [%8.2f, %8.2f] %10.2f %s  %4d/%-4d %3d %3d %3d  %s" % (
        b.name, call_width(unit), s["per_call"], lo, hi, s["raw_per_op"], per_op,
        s["kept"], s["samples"], rej["ratio"], rej["ctx"], rej["migrate"],
        ", ".join(notes))


def main():
    # quiet exit when the reader closes the pipe (| head)
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("files", nargs="+", help="JSONL files written by a benchmark")
    args = ap.parse_args()

    for path in args.files:
        run = bm_stats.Run(path)
        print("== %s" % path)
        for line in env_lines(run):
            print(line)
        print(calib_line(run))
        warnings = run.env.get("warnings", [])
        print("warnings: %d" % len(warnings))
        for w in warnings:
            print("  - " + w.replace("\n", "\n    "))
        print()
        print("%-36s %*s %20s %10s %10s  %9s %3s %3s %3s  %s" % (
            "benchmark", call_width(run.unit), run.unit + "/call", "95% CI", "raw/op", "corr/op",
            "kept", "rat", "ctx", "mig", "notes"))
        for b in run.benches.values():
            print(bench_line(b, run.unit))
        print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
